# Copy this file to .env and fill in the key for the provider chosen in
# public/js/config.js. Only that provider's key is needed.
# The .env file is never committed and never sent to the browser.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional
# PORT=3000
# HOST=127.0.0.1
# AI_DEX_DEMO=1        # force sample answers (same as: npm run demo)
